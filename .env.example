# ------------------------------------------------------------------
# Copy this file to .env and fill in real values.
# NEVER commit real secrets. All values here are placeholders.
# ------------------------------------------------------------------

# --- App --- #
APP_NAME="EstateFlow CRM"
NODE_ENV="development"

# DEMO_MODE bypasses password auth with a seeded SUPER_ADMIN user.
# Use ONLY for local development / testing. Set to false in production.
AUTH_DEMO_MODE="true"

# How long a signed-in session lasts, in days.
SESSION_TTL_DAYS="7"

# --- Background job queue (required in production) ---
# Shared secret for POST/GET /api/internal/process-queue, which Vercel Cron
# calls. Generate with: openssl rand -hex 32
# The route fails CLOSED - if this is unset, the queue endpoint returns 403 and
# scheduled jobs stop running. Generate a long random value; never commit it.
CRON_SECRET=""

# --- Neon PostgreSQL (cloud DB) ---
# Get from Neon console -> Connection details -> pooled connection string.
# Use the POOLED (-pooler) host: serverless invocations each open their own
# pool, and the direct host exhausts connections quickly under load.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/dbname?sslmode=require"

# Optional. Caps how many connections one process holds. Defaults to 2 on
# Vercel/serverless and 20 on a long-lived Node process.
# DB_POOL_MAX="2"

# --- Auth ---
# No external identity provider. Passwords are scrypt-hashed in the database
# and sessions are opaque tokens stored in the `sessions` table.
#
# Create the bootstrap super-admin once with:
#   npm run db:ensure-admin
# Default credentials: crm@gmail.com / crm123
#
# Change that password before exposing the app publicly — it is a fixed,
# well-known value and is not suitable for a real deployment.

# --- Cloudflare R2 (private object storage for documents) ---
# Leave blank to fall back to LOCAL_* storage (dev only).
R2_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="estateflow-documents"
R2_PUBLIC_URL="" # must stay empty / private bucket

# Local disk fallback (dev-only) - absolute path where files are stored.
LOCAL_STORAGE_DIR=".local-storage"

# --- Integrations (configure per provider later) ---
# Each is optional; enable when credentials available.

# Shared secret for POST /api/webhooks/leads (sent as `x-webhook-secret`).
# Unset means the webhook accepts unauthenticated callers, so set this before
# pointing any real provider at the endpoint. Generate with: openssl rand -hex 32
WEBHOOK_SECRET=""

FB_PAGE_ACCESS_TOKEN=""
IG_BUSINESS_ACCOUNT_ID=""
META_LEADS_VERIFY_TOKEN=""
META_FB_PAGE_ID=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
MAGICBRICKS_API_KEY=""
NINE9ACRES_API_KEY=""
YOUTUBE_ADS_API_KEY=""

# --- AI (optional) ---
# Server-side only: used by /api/leads/[id]/ai to generate a lead summary and
# intent score. Never prefixed with NEXT_PUBLIC_ and never sent to the browser.
# Leave GROQ_API_KEY empty to disable the feature - the lead detail page then
# shows a "not configured" state and all other CRM features work normally.
# Get a key from https://console.groq.com/keys
GROQ_API_KEY=""
# Optional. Defaults to openai/gpt-oss-120b when unset or blank.
GROQ_MODEL="openai/gpt-oss-120b"
# --- Simple UI (phone-first flow for SALES_EXECUTIVE) ---
# Off by default. When "true", /home, /today, /new-lead, /my-leads and
# /new-payment serve the reduced UI, and a SALES_EXECUTIVE landing on /
# is redirected to /home. Every other role keeps the full dashboard.
SIMPLE_UI_ENABLED="false"

# --- Reminder emails (optional) ---
# Leave RESEND_API_KEY blank and the daily 09:00 digest is skipped entirely.
# A key saved through Settings -> Email keys is stored encrypted in the
# database and takes precedence over this variable.
RESEND_API_KEY=""

# IANA timezone used to decide "today" and the 09:00 local send time.
# Defaults to Asia/Kolkata when unset or invalid.
APP_TIMEZONE="Asia/Kolkata"

# Fallback sender, used only when no key is stored in the database.
# Both must match a verified sender/domain in your Resend account.
RESEND_FROM_EMAIL=""
RESEND_FROM_NAME=""

# 32-byte key that encrypts integration secrets at rest (AES-256-GCM).
# Required before /settings/keys will accept a key. Generate with:
#   openssl rand -hex 32
# Rotating it invalidates every stored secret - re-save them afterwards.
SETTINGS_ENCRYPTION_KEY=""